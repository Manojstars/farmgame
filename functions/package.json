  },
  "keywords": [
    "firebase",
    "functions",
    "farmgame"
  ],
  "author": "FarmGame",
  "license": "MIT",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": "20"
  }
}
